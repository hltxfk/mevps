{
  "name": "mevps",
  "main": "worker.js",
  "compatibility_date": "2026-11-26",
  "observability": {
    "enabled": true
  },
  // 静态资源：assets/ 目录（构建产物）由 Cloudflare 边缘直接响应
  // - 命中静态资源的请求不进入 Worker，不消耗请求额度
  // - 仅 /api/* 先进入 Worker 脚本处理
  // - 其余未命中的路径按单页应用回退到 index.html
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // D1 数据库：绑定变量名固定为 db，数据库名为 mevps
  // 注意：故意【不写】database_id —— wrangler (>= 4.45) 部署时会按名称自动创建 D1 并写回 ID
  // （Automatic resource provisioning），即"部署时自动创建数据存 D1"。
  // 若已存在同名数据库则直接复用，数据不丢。
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "mevps"
    }
  ]
}
